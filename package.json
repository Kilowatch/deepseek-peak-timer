{
  "name": "deepseek-peak-timer",
  "version": "1.0.0",
  "description": "Floating desktop timer for DeepSeek peak/off-peak API pricing",
  "main": "main.js",
  "desktopName": "za.kilowatch.deepseekpriceclock.desktop",
  "scripts": {
    "start": "electron .",
    "build:standalone": "electron-builder --win portable",
    "build:windows": "electron-builder --win portable",
    "build:linux": "electron-builder --linux AppImage",
    "build:linux:deb": "electron-builder --linux deb",
    "build:linux:rpm": "electron-builder --linux rpm"
  },
  "devDependencies": {
    "electron": "^34.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "za.kilowatch.deepseekpriceclock",
    "productName": "DeepSeekPriceClock",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "src/assets/icons/icon.png",
      "artifactName": "DeepSeekPriceClock-${version}-${arch}.${ext}",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "DeepSeek Price Clock",
          "Comment": "DeepSeek API peak/off-peak price timer",
          "Categories": "Utility;",
          "Keywords": "DeepSeek;timer;pricing;API;",
          "StartupWMClass": "za.kilowatch.deepseekpriceclock",
          "Terminal": false,
          "Type": "Application"
        }
      }
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "src/assets/icons/app-icon.ico"
    },
    "portable": {
      "artifactName": "DeepSeekPriceClock.exe"
    },
    "directories": {
      "output": "Standalone"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ]
  },
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kilowatch/deepseek-peak-timer.git"
  },
  "homepage": "https://github.com/Kilowatch/deepseek-peak-timer#readme"
}
